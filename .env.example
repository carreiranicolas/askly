# Flask
FLASK_APP=app
FLASK_DEBUG=1
SECRET_KEY=troque-por-um-valor-aleatorio
ASKLY_ADMIN_EMAIL=admin@askly.local
ASKLY_ADMIN_PASSWORD=
ASKLY_USER_EMAIL=usuario@askly.local
ASKLY_USER_PASSWORD=

# Fuso para exibição de datas (armazenadas sempre em UTC)
APP_TIMEZONE=America/Sao_Paulo

# Postgres (mesmas variáveis usadas pelo docker-compose)
POSTGRES_USER=askly
POSTGRES_PASSWORD=askly_dev_password
POSTGRES_DB=askly_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Alternativa: definir a URL completa sobrescreve as variáveis acima
# DATABASE_URL=postgresql+psycopg2://askly:askly_dev_password@localhost:5432/askly_db
